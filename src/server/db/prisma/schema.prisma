model Role {
  id         String      @id @default(cuid())
  name       String
  deletedAt  DateTime?   @map("deleted_at")
  applicants Applicant[]

  @@index([deletedAt])
  @@map("role")
}

model Area {
  id          String       @id @default(cuid())
  name        String
  deletedAt   DateTime?    @map("deleted_at")
  applicants  Applicant[]
  jobOpenings JobOpening[]

  @@index([deletedAt])
  @@map("area")
}

model Seniority {
  id          String       @id @default(cuid())
  name        String
  order       Int
  color       String
  deletedAt   DateTime?    @map("deleted_at")
  applicants  Applicant[]
  jobOpenings JobOpening[] @relation("JobOpeningToSeniority")

  @@index([deletedAt])
  @@map("seniority")
}

model Tag {
  id         String      @id @default(cuid())
  name       String
  isSkill    Boolean     @map("is_skill")
  color      String
  deletedAt  DateTime?   @map("deleted_at")
  applicants Applicant[] @relation("ApplicantToTag")

  @@index([deletedAt])
  @@map("tag")
}

model JobOpening {
  id                String           @id @default(cuid())
  name              String
  status            JobOpeningStatus
  stages            Json
  location          String
  openingDate       DateTime         @map("opening_date")
  targetClosingDate DateTime         @map("target_closing_date")
  closingDate       DateTime?        @map("closing_date")
  areaId            String           @map("area_id")
  applications      Application[]
  area              Area             @relation(fields: [areaId], references: [id])
  hiringManagers    User[]           @relation("JobOpeningHiringManagers")
  seniorities       Seniority[]      @relation("JobOpeningToSeniority")

  @@index([areaId])
  @@index([status])
  @@map("job_opening")
}

model StageTemplate {
  id           String    @id @default(cuid())
  stages       Json
  lastModified DateTime? @map("last_modified")
  deletedAt    DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("stage_template")
}

model Application {
  applicantId            String       @map("applicant_id")
  jobOpeningId           String       @map("job_opening_id")
  applicationDate        DateTime     @default(now()) @map("application_date")
  active                 Boolean      @default(true)
  currentStage           String       @map("current_stage")
  stageEntryDate         DateTime     @default(now()) @map("stage_entry_date")
  disqualificationDate   DateTime?    @map("disqualification_date")
  disqualificationReason String?      @map("disqualification_reason")
  desiredSalary          String?      @map("desired_salary")
  availability           String?
  activities             Activity[]
  applicant              Applicant    @relation(fields: [applicantId], references: [id])
  jobOpening             JobOpening   @relation(fields: [jobOpeningId], references: [id])
  interviews             Interview[]
  publicLinks            PublicLink[]

  @@id([applicantId, jobOpeningId])
  @@index([jobOpeningId, active, currentStage])
  @@map("application")
}

model Interview {
  id           String          @id @default(cuid())
  name         String
  duration     Int
  modality     InterviewType
  date         DateTime?
  status       InterviewStatus
  summary      String?
  applicantId  String          @map("applicant_id")
  jobOpeningId String?         @map("job_opening_id")
  applicant    Applicant       @relation(fields: [applicantId], references: [id])
  application  Application?    @relation(fields: [applicantId, jobOpeningId], references: [applicantId, jobOpeningId])
  note         InterviewNote?
  interviewers User[]          @relation("InterviewUsers")

  @@index([applicantId, jobOpeningId])
  @@index([status, date])
  @@map("interview")
}

model ApplicantNote {
  id               String    @id @default(cuid())
  content          String
  lastModified     DateTime  @default(now()) @updatedAt @map("last_modified")
  applicantId      String    @unique @map("applicant_id")
  lastModifiedById String    @map("last_modified_by_id")
  applicant        Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  lastModifiedBy   User      @relation(fields: [lastModifiedById], references: [id])

  @@index([lastModifiedById])
  @@map("applicant_note")
}

model InterviewNote {
  id               String    @id @default(cuid())
  content          String
  lastModified     DateTime  @default(now()) @updatedAt @map("last_modified")
  interviewId      String    @unique @map("interview_id")
  lastModifiedById String    @map("last_modified_by_id")
  interview        Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  lastModifiedBy   User      @relation(fields: [lastModifiedById], references: [id])

  @@index([lastModifiedById])
  @@map("interview_note")
}

model Activity {
  id           String       @id @default(cuid())
  description  String
  date         DateTime     @default(now())
  applicantId  String       @map("applicant_id")
  jobOpeningId String?      @map("job_opening_id")
  applicant    Applicant    @relation(fields: [applicantId], references: [id])
  application  Application? @relation(fields: [applicantId, jobOpeningId], references: [applicantId, jobOpeningId])

  @@index([applicantId, date])
  @@index([applicantId, jobOpeningId])
  @@map("activity")
}

model Invitation {
  id             String   @id @default(cuid())
  token          String   @unique
  sentDate       DateTime @default(now()) @map("sent_date")
  expirationDate DateTime @map("expiration_date")
  senderId       String   @map("sender_id")
  recipientId    String   @map("recipient_id")
  recipient      User     @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender         User     @relation("InvitationSender", fields: [senderId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([expirationDate])
  @@map("invitation")
}

model PublicLink {
  id             String      @id @default(cuid())
  name           String
  token          String      @unique
  includeSalary  Boolean     @default(false) @map("include_salary")
  creationDate   DateTime    @default(now()) @map("creation_date")
  expirationDate DateTime    @map("expiration_date")
  createdById    String      @map("created_by_id")
  applicantId    String      @map("applicant_id")
  jobOpeningId   String      @map("job_opening_id")
  application    Application @relation(fields: [applicantId, jobOpeningId], references: [applicantId, jobOpeningId], onDelete: Cascade)
  createdBy      User        @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([applicantId, jobOpeningId])
  @@index([expirationDate])
  @@map("public_link")
}
